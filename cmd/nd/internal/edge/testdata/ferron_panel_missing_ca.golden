# Managed by nd edge for panel "vps-1" (aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee). DO NOT EDIT. etag=etag-noca
noca.example.com {
    use nd_common
    tls {
        provider acme
        challenge http-01
        cache "/var/cache/ferron-acme"
    }
    proxy {
        upstream "https://204.136.10.51:443" {
            limit 256
            idle_timeout "90s"
            connection_timeout "10s"
        }
        keepalive
        retry_connection
        retry_interval "0.25s"
        no_verification
        request_header X-Forwarded-Proto "https"
        request_header X-Real-IP "{{remote.ip}}"
        request_header X-Forwarded-For "{{remote.ip}}"
        request_header -CF-Connecting-IP
    }
}
